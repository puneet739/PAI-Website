# Database Configuration
DATABASE_URL=mysql://pai_user:pai_password@localhost:3306/pai_db

# MySQL Root Password (for docker-compose)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=pai_db
MYSQL_USER=pai_user
MYSQL_PASSWORD=pai_password

# Application Configuration
NODE_ENV=development
PORT=3000

# Session Secret (generate a random string for production)
SESSION_SECRET=your-secret-key-here

# Email Configuration (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
