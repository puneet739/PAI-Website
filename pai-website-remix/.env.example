# Database Configuration
DATABASE_URL=mysql://pai_user:pai_password@localhost:3306/pai_db

# MySQL Root Password (for docker-compose)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=pai_db
MYSQL_USER=pai_user
MYSQL_PASSWORD=pai_password

# Application Configuration
NODE_ENV=development
PORT=3000

# Session Secret (generate a random string for production)
SESSION_SECRET=developmentpai

# JWT Secret (generate a random string for production)
JWT_SECRET=developmentpai

# Email Configuration
ENABLE_EMAIL=false

# Email Provider: Choose between "SMTP" or "RESEND"
EMAIL_PROVIDER=SMTP

# SMTP Configuration (used when EMAIL_PROVIDER=SMTP)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@pai.org
SMTP_PASSWORD=test


# Email Addresses
FROM_EMAIL=noreply@pai.org.in
BASE_EMAIL=base@pai.org

